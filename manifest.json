{
  "manifest_version": 3,
  "name": "Tencent AI Detect",
  "version": "1.5.3",
  "description": "Browser extension for Tencent AI Detect.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "contextMenus",
    "sidePanel",
    "nativeMessaging",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://matrix.tencent.com/ai-detect/*",
    "https://matrix.tencent.com/*",
    "https://captcha.gtimg.com/*",
    "https://t.captcha.qq.com/*",
    "https://captcha.qq.com/*",
    "http://127.0.0.1:9420/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://matrix.tencent.com/ai-detect/*",
        "https://matrix.tencent.com/*"
      ],
      "js": [
        "src/shim/index.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://matrix.tencent.com/ai-detect/*",
        "https://matrix.tencent.com/*"
      ],
      "js": [
        "src/content/core.js",
        "src/content/identity.js",
        "src/content/detection.js",
        "src/content/engine.js",
        "src/content/index.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Tencent AI Detect",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
